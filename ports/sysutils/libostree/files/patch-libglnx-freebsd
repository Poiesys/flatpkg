FreeBSD lacks the Linux syscalls libglnx shims wrap, plus loff_t and
fallocate(2).  Define loff_t as off_t, skip inline definitions libc
provides, add a no-op fallocate(), and guard sendfile/prctl includes.

--- libglnx/glnx-missing-syscall.h.orig
+++ libglnx/glnx-missing-syscall.h
@@ -33,6 +33,10 @@
 
 #include "libglnx-config.h"
 
+#ifndef loff_t
+typedef off_t loff_t;
+#endif
+
 #if !HAVE_DECL_RENAMEAT2
 #  ifndef __NR_renameat2
 #    if defined __x86_64__
@@ -64,6 +68,7 @@
 #    endif
 #  endif
 
+#if !defined(__FreeBSD__)
 static inline int renameat2(int oldfd, const char *oldname, int newfd, const char *newname, unsigned flags) {
 #  ifdef __NR_renameat2
         return syscall(__NR_renameat2, oldfd, oldname, newfd, newname, flags);
@@ -104,6 +109,7 @@
 #  endif
 
 static inline int memfd_create(const char *name, unsigned int flags) {
+#endif
 #  ifdef __NR_memfd_create
         return syscall(__NR_memfd_create, name, flags);
 #  else
@@ -141,6 +147,7 @@
 #    endif
 #  endif
 
+#if !defined(__FreeBSD__)
 static inline ssize_t missing_copy_file_range(int fd_in, loff_t *off_in,
                                               int fd_out, loff_t *off_out,
                                               size_t len,
@@ -152,6 +159,7 @@
         return -1;
 #  endif
 }
+#endif
 
 #  define copy_file_range missing_copy_file_range
 #endif
--- libglnx/glnx-fdio.h.orig
+++ libglnx/glnx-fdio.h
@@ -221,6 +221,16 @@
  * support it.  Use this instead of posix_fallocate(), since the glibc fallback
  * is bad: https://sourceware.org/bugzilla/show_bug.cgi?id=18515
  */
+#ifndef HAVE_FALLOCATE
+static inline int
+fallocate (int fd, int mode, off_t offset, off_t len)
+{
+  (void)mode; (void)offset; (void)len;
+  errno = ENOSYS;
+  return -1;
+}
+#endif
+
 static inline gboolean
 glnx_try_fallocate (int      fd,
                     off_t    offset,
--- libglnx/glnx-fdio.c.orig
+++ libglnx/glnx-fdio.c
@@ -30,7 +30,12 @@
 #include <stdint.h>
 #include <stdbool.h>
 #include <sys/ioctl.h>
+/* FreeBSD has no <sys/sendfile.h>; its sendfile(2) lives in
+ * <sys/socket.h> but requires a socket output and takes a different
+ * prototype, so glnx_regfile_copy_bytes() skips it entirely. */
+#ifndef __FreeBSD__
 #include <sys/sendfile.h>
+#endif
 #include <errno.h>
 
 #include <glnx-fdio.h>
@@ -869,6 +874,12 @@
       /* Next try sendfile(); this version is also changed from systemd upstream
        * to match the same logic we have for copy_file_range().
        */
+/* FreeBSD: sendfile(2) requires a socket output and has a different
+ * prototype; report ENOSYS here so the read/write fallback below is used. */
+#ifdef __FreeBSD__
+          n = -1;
+          errno = ENOSYS;
+#else
       if (try_sendfile && max_bytes != (off_t) -1)
         {
           n = sendfile (fdt, fdf, NULL, max_bytes);
@@ -899,6 +910,7 @@
                 goto next;
             }
         }
+#endif
 
       /* As a fallback just copy bits by hand */
       { size_t m = COPY_BUFFER_SIZE;
--- libglnx/glnx-backport-testutils.c.orig
